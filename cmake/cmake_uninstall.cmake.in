set(manifest "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")

if(NOT EXISTS "${manifest}")
  message(FATAL_ERROR "Cannot find install manifest: ${manifest}")
endif()

file(READ "${manifest}" manifest_contents)
string(REGEX REPLACE "\r?\n" ";" installed_files "${manifest_contents}")
list(FILTER installed_files EXCLUDE REGEX "^$")

if(NOT installed_files)
  message(FATAL_ERROR "Install manifest is empty: ${manifest}")
endif()

set(actual_files "")
foreach(file IN LISTS installed_files)
  set(actual_file "$ENV{DESTDIR}${file}")
  cmake_path(NORMAL_PATH actual_file)
  list(APPEND actual_files "${actual_file}")
endforeach()

list(GET actual_files 0 first_file)
get_filename_component(common_dir "${first_file}" DIRECTORY)
foreach(file IN LISTS actual_files)
  get_filename_component(file_dir "${file}" DIRECTORY)
  set(common_dir_with_slash "${common_dir}/")
  set(file_dir_with_slash "${file_dir}/")
  string(FIND "${file_dir_with_slash}" "${common_dir_with_slash}" prefix_index)
  while(NOT prefix_index EQUAL 0)
    get_filename_component(parent_dir "${common_dir}" DIRECTORY)
    if(parent_dir STREQUAL common_dir)
      message(FATAL_ERROR "Could not find common install prefix for ${actual_files}")
    endif()
    set(common_dir "${parent_dir}")
    set(common_dir_with_slash "${common_dir}/")
    string(FIND "${file_dir_with_slash}" "${common_dir_with_slash}" prefix_index)
  endwhile()
endforeach()

set(dirs_to_prune "")
foreach(file IN LISTS actual_files)
  if(EXISTS "${file}" OR IS_SYMLINK "${file}")
    message(STATUS "Uninstalling ${file}")
    execute_process(
      COMMAND "@CMAKE_COMMAND@" -E rm -f "${file}"
      RESULT_VARIABLE remove_result)
    if(NOT remove_result EQUAL 0)
      message(FATAL_ERROR "Failed to remove ${file}")
    endif()
  else()
    message(STATUS "Already removed ${file}")
  endif()

  get_filename_component(dir "${file}" DIRECTORY)
  while(TRUE)
    list(APPEND dirs_to_prune "${dir}")
    if(dir STREQUAL common_dir)
      break()
    endif()
    get_filename_component(parent_dir "${dir}" DIRECTORY)
    if(parent_dir STREQUAL dir)
      break()
    endif()
    set(dir "${parent_dir}")
  endwhile()
endforeach()

list(REMOVE_DUPLICATES dirs_to_prune)
set(pruned TRUE)
while(pruned)
  set(pruned FALSE)
  foreach(dir IN LISTS dirs_to_prune)
    if(EXISTS "${dir}")
      file(GLOB children
        LIST_DIRECTORIES TRUE
        "${dir}/*"
        "${dir}/.[!.]*"
        "${dir}/..?*")
      if(NOT children)
        file(REMOVE_RECURSE "${dir}")
        set(pruned TRUE)
      endif()
    endif()
  endforeach()
endwhile()
